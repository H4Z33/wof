					if wt == 0: tick_rate = r.uint32()
					else: r.skip(wt)
				4:
					if wt == 0: server_tick = r.uint32()
					else: r.skip(wt)
				5:
					if wt == 5: move_speed = r.f32()
					else: r.skip(wt)
				6:
					if wt != 2:
						r.skip(wt)
					else:
						var sub := r.sub()
						var v := Vec3.new()
