						var v := TerrainInfo.new()
						v._read(sub)
						if sub.failed: r.failed = true
						terrain = v
				13:
					if wt != 2:
						r.skip(wt)
					else:
						var sub := r.sub()
						var v := ClassInfo.new()
						v._read(sub)
						if sub.failed: r.failed = true
						class_info = v
