						if sub.failed: r.failed = true
						spawn = v
				7:
					if wt == 5: half_extent = r.f32()
					else: r.skip(wt)
				8:
					if wt != 2:
						r.skip(wt)
					else:
						var sub := r.sub()
						var v := SkillInfo.new()
						v._read(sub)
						if sub.failed: r.failed = true
						skills.append(v)
				9:
					if wt != 2:
						r.skip(wt)
					else:
						var sub := r.sub()
						var v := PlayerStatus.new()
						v._read(sub)
						if sub.failed: r.failed = true
						status = v
				10:
					if wt == 2: character_name = r.string()
					else: r.skip(wt)
				11:
					if wt != 2:
						r.skip(wt)
					else:
						var sub := r.sub()
						var v := InventoryItem.new()
						v._read(sub)
						if sub.failed: r.failed = true
						inventory.append(v)
				12:
