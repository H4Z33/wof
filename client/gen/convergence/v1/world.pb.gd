					r.skip(wt)

	func to_bytes() -> PackedByteArray:
		var w := _Writer.new()
		_write(w)
		return w.buf

	# Returns null if the bytes are malformed.
	static func from_bytes(b: PackedByteArray) -> Pong:
		var m := Pong.new()
		var r := _Reader.new(b, 0, b.size())
		m._read(r)
		return null if r.failed else m

class ServerError:
	extends RefCounted
	var code: String = ""
	var message: String = ""

	func _write(w: _Writer) -> void:
		if not code.is_empty():
			w.tag(1, 2)
			w.string(code)
		if not message.is_empty():
			w.tag(2, 2)
			w.string(message)

	func _read(r: _Reader) -> void:
		while not r.at_end():
			var tag := r.varint()
			var wt := tag & 7
			match tag >> 3:
				1:
					if wt == 2: code = r.string()
					else: r.skip(wt)
				2:
					if wt == 2: message = r.string()
					else: r.skip(wt)
				_:
					r.skip(wt)

	func to_bytes() -> PackedByteArray:
		var w := _Writer.new()
		_write(w)
		return w.buf

	# Returns null if the bytes are malformed.
	static func from_bytes(b: PackedByteArray) -> ServerError:
		var m := ServerError.new()
		var r := _Reader.new(b, 0, b.size())
		m._read(r)
		return null if r.failed else m

