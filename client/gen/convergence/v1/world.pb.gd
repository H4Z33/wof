class Welcome:
	extends RefCounted
	var entity_id: int = 0
	var zone_id: String = ""
	var tick_rate: int = 0
	var server_tick: int = 0
	var move_speed: float = 0.0
	var spawn: Vec3 = null
	var half_extent: float = 0.0
	var skills: Array[SkillInfo] = []
	var status: PlayerStatus = null
	var character_name: String = ""
	var inventory: Array[InventoryItem] = []
	var terrain: TerrainInfo = null
	var class_info: ClassInfo = null
	var weapon: WeaponInfo = null
	var action_rules: ActionRules = null

	func _write(w: _Writer) -> void:
		if entity_id != 0:
			w.tag(1, 0)
			w.varint(entity_id)
		if not zone_id.is_empty():
			w.tag(2, 2)
			w.string(zone_id)
		if tick_rate != 0:
			w.tag(3, 0)
			w.varint(tick_rate)
		if server_tick != 0:
			w.tag(4, 0)
			w.varint(server_tick)
		if move_speed != 0.0:
			w.tag(5, 5)
			w.f32(move_speed)
		if spawn != null:
			w.message(6, spawn)
		if half_extent != 0.0:
			w.tag(7, 5)
			w.f32(half_extent)
		for v in skills:
			w.message(8, v)
		if status != null:
			w.message(9, status)
		if not character_name.is_empty():
			w.tag(10, 2)
			w.string(character_name)
		for v in inventory:
			w.message(11, v)
		if terrain != null:
			w.message(12, terrain)
		if class_info != null:
			w.message(13, class_info)
		if weapon != null:
			w.message(14, weapon)
		if action_rules != null:
			w.message(15, action_rules)

	func _read(r: _Reader) -> void:
		while not r.at_end():
			var tag := r.varint()
