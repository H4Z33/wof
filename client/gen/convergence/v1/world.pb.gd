class Snapshot:
	extends RefCounted
	var tick: int = 0
	var ack_input_seq: int = 0
	var entities: Array[EntityState] = []
	var spawns: Array[EntitySpawn] = []
	var despawns: Array[int] = []
	var events: Array[CombatEvent] = []
	var status: PlayerStatus = null

	func _write(w: _Writer) -> void:
		if tick != 0:
			w.tag(1, 0)
			w.varint(tick)
		if ack_input_seq != 0:
			w.tag(2, 0)
			w.varint(ack_input_seq)
		for v in entities:
			w.message(3, v)
		for v in spawns:
			w.message(4, v)
		if not despawns.is_empty():
			var pw := _Writer.new()
			for v in despawns:
				pw.varint(v)
			w.tag(5, 2)
			w.varint(pw.buf.size())
			w.buf.append_array(pw.buf)
		for v in events:
			w.message(6, v)
		if status != null:
			w.message(7, status)

	func _read(r: _Reader) -> void:
		while not r.at_end():
			var tag := r.varint()
			var wt := tag & 7
			match tag >> 3:
				1:
					if wt == 0: tick = r.uint32()
					else: r.skip(wt)
				2:
					if wt == 0: ack_input_seq = r.uint32()
					else: r.skip(wt)
				3:
					if wt != 2:
						r.skip(wt)
					else:
						var sub := r.sub()
						var v := EntityState.new()
						v._read(sub)
						if sub.failed: r.failed = true
						entities.append(v)
				4:
					if wt != 2:
						r.skip(wt)
					else:
						var sub := r.sub()
						var v := EntitySpawn.new()
						v._read(sub)
						if sub.failed: r.failed = true
						spawns.append(v)
				5:
					if wt == 2:
						var sub := r.sub()
						while not sub.at_end(): despawns.append(sub.uint32())
						if sub.failed: r.failed = true
					elif wt == 0: despawns.append(r.uint32())
					else: r.skip(wt)
				6:
					if wt != 2:
						r.skip(wt)
					else:
						var sub := r.sub()
						var v := CombatEvent.new()
						v._read(sub)
						if sub.failed: r.failed = true
						events.append(v)
				7:
					if wt != 2:
						r.skip(wt)
					else:
						var sub := r.sub()
						var v := PlayerStatus.new()
						v._read(sub)
						if sub.failed: r.failed = true
						status = v
				_:
					r.skip(wt)

	func to_bytes() -> PackedByteArray:
		var w := _Writer.new()
		_write(w)
		return w.buf

	# Returns null if the bytes are malformed.
	static func from_bytes(b: PackedByteArray) -> Snapshot:
		var m := Snapshot.new()
		var r := _Reader.new(b, 0, b.size())
		m._read(r)
		return null if r.failed else m

